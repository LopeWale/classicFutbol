{$PSFC_DOMAIN:localhost} {
    encode zstd gzip

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    @demo_reset path /api/worlds/*/reset-demo
    respond @demo_reset 403

    reverse_proxy psfc-host:8000
}
